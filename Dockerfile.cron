# ============================================
# Stage 1: Build dependencies
# ============================================
FROM composer:2 AS builder

WORKDIR /app

COPY composer.json composer.lock ./
RUN composer install --no-dev --optimize-autoloader --no-interaction --ignore-platform-reqs

COPY . .


# ============================================
# Stage 2: Build PHP extensions
# ============================================
# Pin PHP 8.3.36+ to mitigate PHP2Shell (CVE-2026-109618, CVE-2026-109619).
# Digest locks the multi-arch index so rebuilds cannot silently regress.
FROM php:8.3.36-cli-alpine@sha256:9e3f659660bf060ac3baaa56bfdfb07ef92d12cda24e702cc762ef7fb036cfb6 AS php-ext-builder

RUN apk add --no-cache \
    icu-dev \
    libzip-dev \
    gcc \
    make \
    musl-dev

RUN docker-php-ext-install -j$(nproc) \
    pdo \
    pdo_mysql \
    zip \
    intl


# ============================================
# Stage 3: Cron runtime
# ============================================
FROM php:8.3.36-cli-alpine@sha256:9e3f659660bf060ac3baaa56bfdfb07ef92d12cda24e702cc762ef7fb036cfb6 AS production

WORKDIR /var/www

RUN apk add --no-cache \
    curl \
    icu \
    icu-libs \
    libzip \
    cronie

COPY --from=php-ext-builder /usr/local/lib/php/extensions/ /usr/local/lib/php/extensions/
COPY --from=php-ext-builder /usr/local/etc/php/conf.d/ /usr/local/etc/php/conf.d/

COPY --from=builder /app /var/www

RUN php init --env=Production --overwrite=n

RUN mkdir -p /var/www/feed \
    && chown -R www-data:www-data /var/www \
    && chmod -R 755 /var/www \
    && chmod -R 775 /var/www/feed

COPY docker/cron/crontab /etc/crontabs/www-data

RUN touch /var/log/cron.log

COPY docker/cron/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

HEALTHCHECK --interval=60s --timeout=10s --retries=3 --start-period=120s \
    CMD test -s /var/www/feed/document.json || exit 1

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]